// Stokko — Prisma schema
// Architecture: Multi-tenant SaaS, organizationId on every owned entity.
// See plan: /Users/pavleandric/.claude/plans/u-ovom-folderu-cemo-humming-toucan.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── ENUMS ─────────────

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum Unit {
  KOM
  KG
  L
  BOCA
  GAJBA
  PAKET
  KUTIJA
}

enum CorrectionType {
  ABSOLUTE
  DELTA
}

enum WarehouseKind {
  STORAGE
  FOH
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CorrectionReason {
  COUNT
  WRITE_OFF
  INPUT_ERROR
  OTHER
}

enum AuditAction {
  // Inventory entities
  ARTICLE_CREATED
  ARTICLE_UPDATED
  ARTICLE_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  WAREHOUSE_CREATED
  WAREHOUSE_UPDATED
  WAREHOUSE_DELETED
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  SUPPLIER_DELETED

  // Stock movements
  PROCUREMENT_CREATED
  CORRECTION_CREATED
  TRANSFER_CREATED

  // Sales (Phase 8a)
  SHIFT_CLOSED
  SALE_CREATED

  // User / org actions
  USER_INVITED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  USER_LOGGED_IN

  // Platform-admin actions (A3/A4)
  ADMIN_IMPERSONATED
  ADMIN_USER_PASSWORD_RESET
  ADMIN_USER_UPDATED
  ADMIN_USER_DEACTIVATED
  ADMIN_USER_REACTIVATED

  // AI Sloj 0 — predictions + shopping lists
  RECOMMENDATION_GENERATED
  SHOPPING_LIST_CREATED
  SHOPPING_LIST_COMPLETED
  SHOPPING_LIST_CANCELLED
  SHOPPING_LIST_ITEM_ADDED
  SHOPPING_LIST_ITEM_REMOVED
  SHOPPING_LIST_ITEM_UPDATED

  // Phase 9 — per-warehouse access (EMPLOYEE) + FOH stock targets
  USER_WAREHOUSE_ACCESS_GRANTED
  USER_WAREHOUSE_ACCESS_REVOKED
  WAREHOUSE_STOCK_TARGET_UPDATED
}

enum Urgency {
  CRITICAL
  WARNING
  OK
}

enum ShoppingListStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NarrativeKind {
  DAILY_DIGEST
  ITEM_EXPLANATION
  ANOMALY
}

// ───────────── PLATFORM ADMIN ─────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ───────────── CORE ─────────────

model Organization {
  id                  String   @id @default(cuid())
  name                String
  currency            String   @default("EUR") // ISO 4217
  isActive            Boolean  @default(true)
  // AI Sloj 0 — per-org reorder defaults (overrideable per-supplier later)
  defaultLeadTimeDays Int      @default(2)
  defaultSafetyDays   Int      @default(1)
  defaultCoverageDays Int      @default(7)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  categories          Category[]
  warehouses          Warehouse[]
  suppliers           Supplier[]
  articles            Article[]
  procurements        Procurement[]
  stockCorrections    StockCorrection[]
  stockTransfers      StockTransfer[]
  shifts              Shift[]
  sales               Sale[]
  predictionSnapshots PredictionSnapshot[]
  shoppingLists       ShoppingList[]
  narratives          RecommendationNarrative[]
}

model User {
  id                 String    @id @default(cuid())
  organizationId     String
  email              String
  passwordHash       String
  role               Role
  firstName          String
  lastName           String
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization           Organization          @relation(fields: [organizationId], references: [id])
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  createdArticles        Article[]             @relation("ArticleCreatedBy")
  createdProcurements    Procurement[]
  createdCorrections     StockCorrection[]
  createdTransfers       StockTransfer[]
  closedShifts           Shift[]
  createdSales           Sale[]
  createdShoppingLists   ShoppingList[]        @relation("ShoppingListCreatedBy")
  completedShoppingLists ShoppingList[]        @relation("ShoppingListCompletedBy")
  warehouseAccess        UserWarehouseAccess[]

  @@unique([organizationId, email])
  @@index([email])
}

model RefreshToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ───────────── INVENTORY ─────────────

model Category {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  isPredefined   Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  articles     Article[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
}

model Warehouse {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  // Hex from the Stokko palette — used as the warehouse's avatar tile
  // and bar-chart colour. Defaults to the primary accent.
  color          String        @default("#2563eb")
  // STORAGE = back-of-house storage; FOH = front-of-house point of sale.
  // Phase 8a: only FOH warehouses participate in shift-close (Obračun).
  kind           WarehouseKind @default(STORAGE)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization        Organization              @relation(fields: [organizationId], references: [id])
  stockEntries        StockEntry[]
  procurements        Procurement[]
  stockCorrections    StockCorrection[]
  transfersOut        StockTransfer[]           @relation("TransferSource")
  transfersIn         StockTransfer[]           @relation("TransferDestination")
  sales               Sale[]
  predictionSnapshots PredictionSnapshot[]
  shoppingListItems   ShoppingListItem[]
  narratives          RecommendationNarrative[]
  stockTargets        WarehouseStockTarget[]
  userAccess          UserWarehouseAccess[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
}

model Supplier {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  note           String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  articles          Article[]
  procurements      Procurement[]
  shoppingListItems ShoppingListItem[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
}

model Article {
  id                String    @id @default(cuid())
  organizationId    String
  sku               String
  name              String
  purchasePrice     Decimal   @db.Decimal(12, 2)
  salePrice         Decimal   @db.Decimal(12, 2)
  unit              Unit
  categoryId        String
  supplierId        String?
  thresholdWarning  Decimal   @db.Decimal(12, 3)
  thresholdCritical Decimal   @db.Decimal(12, 3)
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization        Organization              @relation(fields: [organizationId], references: [id])
  category            Category                  @relation(fields: [categoryId], references: [id])
  supplier            Supplier?                 @relation(fields: [supplierId], references: [id])
  createdBy           User                      @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  stockEntries        StockEntry[]
  procurementItems    ProcurementItem[]
  stockCorrections    StockCorrection[]
  stockTransferItems  StockTransferItem[]
  saleItems           SaleItem[]
  predictionSnapshots PredictionSnapshot[]
  shoppingListItems   ShoppingListItem[]
  narratives          RecommendationNarrative[]
  stockTargets        WarehouseStockTarget[]

  @@unique([organizationId, sku])
  @@unique([organizationId, name])
  @@index([organizationId, categoryId, deletedAt])
  @@index([organizationId, supplierId])
}

model StockEntry {
  articleId   String
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime @updatedAt

  article   Article   @relation(fields: [articleId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([articleId, warehouseId])
  @@index([warehouseId])
}

// ───────────── STOCK MOVEMENTS ─────────────

model Procurement {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String?
  warehouseId    String
  createdById    String
  note           String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  supplier     Supplier?         @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  createdBy    User              @relation(fields: [createdById], references: [id])
  items        ProcurementItem[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([supplierId])
  @@index([warehouseId])
}

model ProcurementItem {
  id            String  @id @default(cuid())
  procurementId String
  articleId     String
  quantity      Decimal @db.Decimal(12, 3)
  purchasePrice Decimal @db.Decimal(12, 2)

  procurement Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  article     Article     @relation(fields: [articleId], references: [id])

  @@index([procurementId])
  @@index([articleId])
}

model StockCorrection {
  id             String           @id @default(cuid())
  organizationId String
  articleId      String
  warehouseId    String
  type           CorrectionType
  // For ABSOLUTE: the new stock level (>= 0).
  // For DELTA: the signed change to apply (may be negative).
  value          Decimal          @db.Decimal(12, 3)
  reason         CorrectionReason
  note           String?
  createdById    String
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  article      Article      @relation(fields: [articleId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([articleId])
  @@index([warehouseId])
}

model StockTransfer {
  id                     String   @id @default(cuid())
  organizationId         String
  sourceWarehouseId      String
  destinationWarehouseId String
  note                   String?
  createdById            String
  createdAt              DateTime @default(now())

  organization         Organization        @relation(fields: [organizationId], references: [id])
  sourceWarehouse      Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  createdBy            User                @relation(fields: [createdById], references: [id])
  items                StockTransferItem[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
}

model StockTransferItem {
  id         String  @id @default(cuid())
  transferId String
  articleId  String
  quantity   Decimal @db.Decimal(12, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  article  Article       @relation(fields: [articleId], references: [id])

  @@index([transferId])
  @@index([articleId])
}

// ───────────── SALES (Phase 8a) ─────────────

model Shift {
  id             String      @id @default(cuid())
  organizationId String
  date           DateTime    @db.Date
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  closedById     String?
  status         ShiftStatus @default(OPEN)
  totalQuantity  Decimal     @default(0) @db.Decimal(12, 3)
  totalRevenue   Decimal     @default(0) @db.Decimal(12, 2)

  organization Organization @relation(fields: [organizationId], references: [id])
  closedBy     User?        @relation(fields: [closedById], references: [id])
  sales        Sale[]

  @@unique([organizationId, date])
  @@index([organizationId, date(sort: Desc)])
}

model Sale {
  id             String   @id @default(cuid())
  organizationId String
  shiftId        String
  warehouseId    String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  shift        Shift        @relation(fields: [shiftId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  items        SaleItem[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([shiftId])
  @@index([warehouseId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  articleId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])

  @@index([saleId])
  @@index([articleId])
}

// ───────────── AI SLOJ 0 — predictions + shopping lists + narratives ─────────────

// Latest computed recommendation per (org, warehouse, article) tuple.
// Newest snapshot accessed by ordering computedAt DESC; older rows preserved
// for trend analysis. Daily cron rewrites the row set; UI reads the latest.
model PredictionSnapshot {
  id                  String   @id @default(cuid())
  organizationId      String
  warehouseId         String
  articleId           String
  currentStock        Decimal  @db.Decimal(12, 3)
  avgDailyConsumption Decimal? @db.Decimal(12, 3)
  daysOfSupply        Decimal? @db.Decimal(12, 2)
  shouldReorder       Boolean  @default(false)
  suggestedQty        Decimal  @default(0) @db.Decimal(12, 3)
  urgency             Urgency  @default(OK)
  leadTimeDaysUsed    Int
  safetyDaysUsed      Int
  coverageDaysUsed    Int
  signalWindowDays    Int
  computedAt          DateTime @default(now())
  validUntil          DateTime

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  article      Article      @relation(fields: [articleId], references: [id])

  @@index([organizationId, warehouseId, articleId, computedAt(sort: Desc)])
  @@index([organizationId, urgency, computedAt(sort: Desc)])
}

// One shopping list per org is "active" (DRAFT or ACTIVE) at a time;
// guard is application-level in ShoppingListsService.requireNoActive().
model ShoppingList {
  id                      String             @id @default(cuid())
  organizationId          String
  status                  ShoppingListStatus @default(DRAFT)
  createdById             String
  completedById           String?
  completedAt             DateTime?
  totalEstimateCents      Int                @default(0)
  currency                String             @default("EUR")
  generatedFromSnapshotAt DateTime?
  note                    String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  createdBy    User               @relation("ShoppingListCreatedBy", fields: [createdById], references: [id])
  completedBy  User?              @relation("ShoppingListCompletedBy", fields: [completedById], references: [id])
  items        ShoppingListItem[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
}

model ShoppingListItem {
  id                  String   @id @default(cuid())
  shoppingListId      String
  articleId           String
  warehouseId         String
  suggestedQty        Decimal  @db.Decimal(12, 3)
  customQty           Decimal? @db.Decimal(12, 3)
  supplierId          String?
  isChecked           Boolean  @default(false)
  addedManually       Boolean  @default(false)
  sortOrder           Int      @default(0)
  estimatedPriceCents Int      @default(0)

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  article      Article      @relation(fields: [articleId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])

  @@unique([shoppingListId, articleId, warehouseId])
  @@index([shoppingListId, sortOrder])
}

// Persisted LLM output — both daily digests (one per org per day) and
// per-article explanations (TTL cached, see narratives.service).
model RecommendationNarrative {
  id             String        @id @default(cuid())
  organizationId String
  kind           NarrativeKind
  body           String
  articleId      String?
  warehouseId    String?
  modelUsed      String
  tokensIn       Int           @default(0)
  tokensOut      Int           @default(0)
  cachedTokens   Int           @default(0)
  costUsd        Decimal       @db.Decimal(10, 6)
  validForDate   DateTime?     @db.Date
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  article      Article?     @relation(fields: [articleId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])

  @@index([organizationId, kind, validForDate(sort: Desc)])
  @@index([organizationId, articleId, warehouseId, createdAt(sort: Desc)])
}

// ───────────── PHASE 9 — PER-WAREHOUSE ACCESS + FOH STOCK TARGETS ─────────────

// EMPLOYEE-only access scoping. OWNER/ADMIN ignore this table (see all
// warehouses). EMPLOYEE without any row → sees no warehouses (safe default).
model UserWarehouseAccess {
  userId      String
  warehouseId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([userId])
  @@index([warehouseId])
}

// Optimal target quantity for an (article, warehouse) pair. Used by
// shift-close auto-replenish flow to compute delta = target - currentStock
// and propose a transfer from a BOH source. Only FOH warehouses are
// expected to have rows; enforcement lives in the domain service.
model WarehouseStockTarget {
  warehouseId String
  articleId   String
  targetQty   Decimal  @db.Decimal(12, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([warehouseId, articleId])
  @@index([warehouseId])
  @@index([articleId])
}

// ───────────── AUDIT ─────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  action         AuditAction
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}
