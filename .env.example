# Stokko — environment template
DATABASE_URL="postgresql://USER@localhost:5432/stokko?schema=public"

JWT_SECRET="generate-random-64-plus-chars"
JWT_REFRESH_SECRET="generate-different-random-64-plus-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
BCRYPT_ROUNDS="12"

NODE_ENV="development"
PORT="3000"
